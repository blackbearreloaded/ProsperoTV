<rml>
    <head><title>ProsperoTV</title><link type="text/rcss" href="styles/app.rcss" /></head>
    <body>
        <div id="app-shell"><img id="app-background" src="images/background.tga" /><div id="safe-frame">
            <header id="topbar">
                <img id="brand-mark" src="icons/prosperotv.tga" width="56" height="56" alt="" />
                <div id="brand-block"><span id="brand-name">ProsperoTV</span><span id="brand-version">v{{PROSPERO_TV_VERSION}}</span></div>
                <nav id="primary-nav"><button id="nav-live-tv" class="nav-item active"><span>Live TV</span></button><button id="nav-favorites" class="nav-item"><span>Favorites</span></button><button id="nav-sources" class="nav-item"><span>Sources</span></button></nav>
                <div id="header-status" class="status-inline"><span id="header-status-dot" class="status-dot ready"></span><span id="header-status-label">Ready</span></div>
            </header>

            <main id="content-shell">
                <section id="screen-live-tv" class="screen">
                    <div id="live-tv-heading" class="screen-heading">Live TV</div><div id="live-tv-subtitle" class="screen-subtitle">Browse the cached catalog instantly. Circle returns to Quick Views from any channel page.</div>
                    <section id="source-region" class="rail-panel"><span class="panel-kicker">SOURCE</span><div class="rail-list">
                        <div id="source-slot-0" class="rail-item selected"><span id="source-name-0">iptv-org</span><span id="source-meta-0">Public M3U</span><span id="source-status-0" class="item-status">LOADING</span></div>
                        <div id="source-slot-1" class="rail-item hidden"><span id="source-name-1">Custom playlist</span><span id="source-meta-1">Add URL</span><span id="source-status-1" class="item-status">EMPTY</span></div>
                    </div></section>
                    <section id="group-region" class="rail-panel"><span class="panel-kicker">QUICK VIEWS</span><div class="rail-list">
                        <button id="group-slot-0" class="rail-item group-item selected"><span>All</span><span id="group-count-0">--</span></button>
                        <button id="group-slot-1" class="rail-item group-item"><span>Favorites</span><span id="group-count-1">--</span></button>
                        <button id="group-slot-2" class="rail-item group-item"><span>Recent</span><span id="group-count-2">--</span></button>
                        <button id="group-slot-3" class="rail-item group-item"><span>News</span><span id="group-count-3">--</span></button>
                        <button id="group-slot-4" class="rail-item group-item"><span>Sports</span><span id="group-count-4">--</span></button>
                        <button id="group-slot-5" class="rail-item group-item"><span>Kids</span><span id="group-count-5">--</span></button>
                    </div></section>
                    <section id="search-region" class="rail-panel"><span class="panel-kicker">SEARCH &amp; FILTER</span><button id="search-input"><img src="icons/search.tga" width="32" height="32" alt=""/><span id="search-query">Search and filter channels</span><span id="search-clear" class="hidden">ACTIVE</span></button><span id="search-hint">Triangle opens advanced search</span></section>

                    <section id="channel-region"><div id="channel-list">
                        <button id="channel-slot-0" class="channel-card selected"><span id="channel-number-0" class="channel-number">1</span><span id="channel-logo-0" class="channel-logo">TV</span><span id="channel-name-0" class="channel-name">Channel</span><span id="channel-meta-0" class="channel-meta">World</span><span id="channel-live-0" class="live-marker">LIVE</span><span id="channel-favorite-0" class="favorite-marker">FAVORITE</span><span id="channel-recent-0" class="recent-marker">RECENT</span><span id="channel-playback-0" class="playback-marker">PLAYABLE</span><span id="channel-tech-0" class="channel-tech">AUTO | AUTO | FPS AUTO</span></button>
                        <button id="channel-slot-1" class="channel-card"><span id="channel-number-1" class="channel-number">2</span><span id="channel-logo-1" class="channel-logo">TV</span><span id="channel-name-1" class="channel-name">Channel</span><span id="channel-meta-1" class="channel-meta">World</span><span id="channel-live-1" class="live-marker">LIVE</span><span id="channel-favorite-1" class="favorite-marker">FAVORITE</span><span id="channel-recent-1" class="recent-marker">RECENT</span><span id="channel-playback-1" class="playback-marker">PLAYABLE</span><span id="channel-tech-1" class="channel-tech">AUTO | AUTO | FPS AUTO</span></button>
                        <button id="channel-slot-2" class="channel-card"><span id="channel-number-2" class="channel-number">3</span><span id="channel-logo-2" class="channel-logo">TV</span><span id="channel-name-2" class="channel-name">Channel</span><span id="channel-meta-2" class="channel-meta">World</span><span id="channel-live-2" class="live-marker">LIVE</span><span id="channel-favorite-2" class="favorite-marker">FAVORITE</span><span id="channel-recent-2" class="recent-marker">RECENT</span><span id="channel-playback-2" class="playback-marker">PLAYABLE</span><span id="channel-tech-2" class="channel-tech">AUTO | AUTO | FPS AUTO</span></button>
                        <button id="channel-slot-3" class="channel-card"><span id="channel-number-3" class="channel-number">4</span><span id="channel-logo-3" class="channel-logo">TV</span><span id="channel-name-3" class="channel-name">Channel</span><span id="channel-meta-3" class="channel-meta">World</span><span id="channel-live-3" class="live-marker">LIVE</span><span id="channel-favorite-3" class="favorite-marker">FAVORITE</span><span id="channel-recent-3" class="recent-marker">RECENT</span><span id="channel-playback-3" class="playback-marker">PLAYABLE</span><span id="channel-tech-3" class="channel-tech">AUTO | AUTO | FPS AUTO</span></button>
                        <button id="channel-slot-4" class="channel-card"><span id="channel-number-4" class="channel-number">5</span><span id="channel-logo-4" class="channel-logo">TV</span><span id="channel-name-4" class="channel-name">Channel</span><span id="channel-meta-4" class="channel-meta">World</span><span id="channel-live-4" class="live-marker">LIVE</span><span id="channel-favorite-4" class="favorite-marker">FAVORITE</span><span id="channel-recent-4" class="recent-marker">RECENT</span><span id="channel-playback-4" class="playback-marker">PLAYABLE</span><span id="channel-tech-4" class="channel-tech">AUTO | AUTO | FPS AUTO</span></button>
                        <button id="channel-slot-5" class="channel-card"><span id="channel-number-5" class="channel-number">6</span><span id="channel-logo-5" class="channel-logo">TV</span><span id="channel-name-5" class="channel-name">Channel</span><span id="channel-meta-5" class="channel-meta">World</span><span id="channel-live-5" class="live-marker">LIVE</span><span id="channel-favorite-5" class="favorite-marker">FAVORITE</span><span id="channel-recent-5" class="recent-marker">RECENT</span><span id="channel-playback-5" class="playback-marker">PLAYABLE</span><span id="channel-tech-5" class="channel-tech">AUTO | AUTO | FPS AUTO</span></button>
                        <button id="channel-slot-6" class="channel-card"><span id="channel-number-6" class="channel-number">7</span><span id="channel-logo-6" class="channel-logo">TV</span><span id="channel-name-6" class="channel-name">Channel</span><span id="channel-meta-6" class="channel-meta">World</span><span id="channel-live-6" class="live-marker">LIVE</span><span id="channel-favorite-6" class="favorite-marker">FAVORITE</span><span id="channel-recent-6" class="recent-marker">RECENT</span><span id="channel-playback-6" class="playback-marker">PLAYABLE</span><span id="channel-tech-6" class="channel-tech">AUTO | AUTO | FPS AUTO</span></button>
                        <button id="channel-slot-7" class="channel-card"><span id="channel-number-7" class="channel-number">8</span><span id="channel-logo-7" class="channel-logo">TV</span><span id="channel-name-7" class="channel-name">Channel</span><span id="channel-meta-7" class="channel-meta">World</span><span id="channel-live-7" class="live-marker">LIVE</span><span id="channel-favorite-7" class="favorite-marker">FAVORITE</span><span id="channel-recent-7" class="recent-marker">RECENT</span><span id="channel-playback-7" class="playback-marker">PLAYABLE</span><span id="channel-tech-7" class="channel-tech">AUTO | AUTO | FPS AUTO</span></button>
                    </div><span id="channel-empty" class="empty-state hidden">No channels match this view.</span></section>

                    <aside id="channel-detail-region"><span class="panel-kicker">SELECTED CHANNEL</span><span id="selected-channel-number">--</span><span id="selected-channel-name">Channel name</span><span id="selected-channel-meta">World | Language | Category</span><span id="selected-channel-tech">AUTO | AUTO | FPS AUTO</span><span id="selected-channel-markers"><span id="selected-channel-favorite" class="favorite-marker">FAVORITE</span><span id="selected-channel-recent" class="recent-marker">RECENT</span><span id="selected-channel-playback" class="playback-marker">PLAYABLE</span></span><button id="channel-play-button" class="primary-action"><img src="icons/play.tga" width="24" height="24" alt=""/><span>Open channel</span></button><div id="preview-status-region"><span id="preview-status-dot" class="status-dot ready"></span><span id="preview-status-title">Ready</span><span id="preview-status-message">Cross opens this channel. Circle or Options returns during playback.</span></div></aside>
                    <div id="live-status-region"><span id="live-status-dot" class="status-dot ready"></span><span id="live-status-label">Catalog ready</span><span id="live-status-detail">Cached channels</span></div>
                    <div id="error-region" class="hidden"><span id="error-title">Unable to load catalog</span><span id="error-message">Try again or open Sources.</span><button id="error-action"><span id="error-action-label">Retry</span></button></div>
                </section>

                <section id="screen-sources" class="screen hidden">
                    <div class="screen-heading">Sources</div><div class="screen-subtitle">Use the free iptv-org catalog or add an HTTP(S) M3U playlist.</div>
                    <section id="source-management-region"><span class="panel-kicker">PLAYLISTS</span><button id="source-management-slot-0" class="source-management-card selected"><span id="source-management-name-0">iptv-org public catalog</span><span id="source-management-url-0">https://iptv-org.github.io/iptv/index.m3u</span><span id="source-management-health-0" class="item-status">STARTING</span></button><button id="source-management-slot-1" class="source-management-card"><span id="source-management-name-1">Add a custom playlist</span><span id="source-management-url-1">Cross to enter an HTTP(S) M3U URL</span><span id="source-management-health-1" class="item-status">EMPTY</span></button></section>
                    <section id="source-status-region"><span class="panel-kicker">SOURCE STATUS</span><span id="source-status-label">Starting catalog</span><span id="source-status-detail">Refresh details appear here.</span><button id="source-refresh-button" class="primary-action"><span id="source-refresh-label">Refresh selected source</span></button></section>
                </section>
            </main>

            <section id="search-overlay" class="hidden"><div id="search-panel"><span class="overlay-kicker">SEARCH THE LOCAL CATALOG</span><span class="overlay-title">Find your channel</span><span id="search-help">Cross changes a filter. Results update instantly.</span><button id="search-query-button"><span class="filter-label">NAME OR KEYWORD</span><span id="search-query-value">Type a channel, country, language or category</span></button><div id="filter-row"><button id="filter-country" class="filter-button"><span class="filter-label">COUNTRY</span><span id="filter-country-value">All countries</span></button><button id="filter-category" class="filter-button"><span class="filter-label">CATEGORY</span><span id="filter-category-value">All categories</span></button><button id="filter-language" class="filter-button"><span class="filter-label">LANGUAGE</span><span id="filter-language-value">All languages</span></button><button id="filter-quality" class="filter-button"><span class="filter-label">QUALITY</span><span id="filter-quality-value">Any quality</span></button></div><span id="search-result-count">0 matching channels in the local cache</span><button id="search-reset"><span>Reset all</span></button><button id="search-apply" class="primary-action"><span>Show results</span></button></div></section>

            <footer id="controller-footer"><span class="controller-hint hint-0"><img src="icons/cross.tga" width="34" height="34" alt=""/><span>Select</span></span><span class="controller-hint hint-1"><img src="icons/circle.tga" width="34" height="34" alt=""/><span>Back / Clear</span></span><span class="controller-hint hint-2"><img src="icons/square.tga" width="34" height="34" alt=""/><span>Favorite</span></span><span class="controller-hint hint-3"><img src="icons/triangle.tga" width="34" height="34" alt=""/><span>Search</span></span><span class="controller-hint hint-4"><span class="control-glyph">L1 / R1</span><span>Section</span></span><span class="controller-hint hint-5"><img src="icons/options.tga" width="34" height="34" alt=""/><span>Refresh</span></span><span id="footer-status"><span id="footer-status-dot" class="status-dot ready"></span><span id="footer-status-label">Ready</span></span></footer>
        </div></div>
    </body>
</rml>
