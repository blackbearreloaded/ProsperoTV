* { box-sizing: border-box; }
body, div, header, main, nav, section, aside, footer, span, button, img { display: block; }
body { width: 1920px; height: 1080px; margin: 0; overflow: hidden; background-color: #171321; color: #fff2df; font-family: "Montserrat"; font-size: 20px; font-weight: 500; line-height: 30px; }
button { margin: 0; padding: 0; overflow: hidden; border: 1px #6f4a61; border-radius: 0px; background-color: #2a2134; color: #fff2df; font-family: "Montserrat"; font-size: 18px; font-weight: 500; line-height: 28px; text-align: left; nav: auto; }

#app-shell, #safe-frame { position: absolute; left: 0px; top: 0px; width: 1920px; height: 1080px; overflow: hidden; }
#app-shell { background-color: #171321; }
#app-background { position: absolute; left: 0px; top: 0px; width: 1920px; height: 1080px; }

#topbar { position: absolute; left: 0px; top: 0px; width: 1920px; height: 96px; border-bottom: 2px #6f4a61; background-color: #171321; }
#brand-mark { position: absolute; left: 64px; top: 20px; width: 56px; height: 56px; }
#brand-block { position: absolute; left: 140px; top: 14px; width: 250px; height: 68px; }
#brand-name { position: absolute; left: 0px; top: 0px; width: 250px; height: 38px; font-size: 32px; line-height: 38px; letter-spacing: 1px; }
#brand-version { position: absolute; left: 0px; top: 38px; width: 180px; height: 30px; color: #f3a447; font-size: 20px; line-height: 30px; }
#primary-nav { position: absolute; left: 510px; top: 18px; width: 790px; height: 60px; }
.nav-item { position: absolute; top: 0px; width: 250px; height: 60px; border-color: #171321; background-color: #171321; color: #c8afb6; text-align: center; }
.nav-item span { position: absolute; left: 0px; top: 14px; width: 250px; text-align: center; }
#nav-live-tv { left: 0px; } #nav-favorites { left: 270px; } #nav-sources { left: 540px; }
.nav-item.active, .nav-item.selected { border-bottom: 3px #f3a447; background-color: #2a2134; color: #fff2df; }
#header-status { position: absolute; right: 64px; top: 28px; width: 300px; height: 36px; color: #e8b968; text-align: right; }
.status-dot { width: 10px; height: 10px; background-color: #64e6a6; }
.status-inline .status-dot { position: absolute; right: 270px; top: 11px; }
.status-inline span:last-child { position: absolute; right: 0px; top: 0px; width: 250px; height: 32px; overflow: hidden; white-space: nowrap; text-align: right; }

#content-shell { position: absolute; left: 64px; top: 112px; width: 1792px; height: 820px; overflow: hidden; }
.screen { position: absolute; left: 0px; top: 0px; width: 1792px; height: 820px; overflow: hidden; }
.screen-heading { position: absolute; left: 0px; top: 0px; width: 720px; height: 48px; font-size: 36px; line-height: 46px; }
.screen-subtitle { position: absolute; left: 0px; top: 48px; width: 1500px; height: 30px; overflow: hidden; color: #c8afb6; font-size: 18px; line-height: 28px; white-space: nowrap; text-overflow: ellipsis; }
.rail-panel, #channel-detail-region, #source-management-region, #source-status-region { overflow: hidden; border: 1px #6f4a61; background-color: #2a2134; }
.panel-kicker { position: absolute; left: 16px; top: 10px; height: 24px; color: #f3a447; font-size: 14px; line-height: 22px; letter-spacing: 1px; }

.rail-panel { position: absolute; top: 88px; height: 112px; }
#source-region { left: 0px; width: 299px; }
#group-region { left: 315px; width: 931px; }
#search-region { left: 1262px; width: 530px; }
.rail-list { position: absolute; left: 16px; top: 42px; width: 100%; height: 56px; overflow: hidden; }
.rail-item { position: absolute; top: 0px; height: 56px; border: 1px #6f4a61; background-color: #191522; }
#source-slot-0, #source-slot-1 { left: 0px; width: 267px; }
.rail-item span { position: absolute; left: 10px; right: 10px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.rail-item span:first-child { top: 4px; height: 25px; font-size: 16px; line-height: 24px; }
.rail-item span:nth-child(2) { top: 28px; height: 20px; color: #c8afb6; font-size: 12px; line-height: 18px; }
.rail-item .item-status { left: 80px; top: 28px; right: 8px; color: #e8b968; text-align: right; }
#source-region .rail-item span:nth-child(2) { right: 58px; }
.group-item { width: 141px; }
#group-slot-0 { left: 0px; } #group-slot-1 { left: 151px; } #group-slot-2 { left: 302px; } #group-slot-3 { left: 453px; } #group-slot-4 { left: 604px; } #group-slot-5 { left: 755px; }
.group-item span:first-child { top: 6px; }
.group-item span:nth-child(2) { top: 29px; text-align: right; }
.rail-item.selected, .rail-item.focused { border: 2px #f3a447; background-color: #573047; }
.rail-item.focused { border-color: #fff2df; }
#search-input { position: absolute; left: 16px; top: 42px; width: 498px; height: 46px; background-color: #191522; }
#search-input img { position: absolute; left: 10px; top: 6px; width: 32px; height: 32px; }
#search-query { position: absolute; left: 52px; top: 7px; width: 348px; height: 30px; overflow: hidden; color: #c8afb6; line-height: 28px; white-space: nowrap; text-overflow: ellipsis; }
#search-clear { position: absolute; right: 10px; top: 8px; width: 72px; color: #f3a447; font-size: 12px; line-height: 26px; text-align: right; }
#search-hint { position: absolute; right: 16px; top: 88px; height: 20px; color: #c8afb6; font-size: 12px; line-height: 18px; }

#channel-region { position: absolute; left: 0px; top: 216px; width: 1246px; height: 528px; overflow: hidden; }
#channel-list { position: absolute; left: 0px; top: 0px; width: 1246px; height: 528px; }
.channel-card { position: absolute; width: 299px; height: 256px; border: 1px #6f4a61; background-color: #2a2134; }
#channel-slot-0 { left: 0px; top: 0px; } #channel-slot-1 { left: 315px; top: 0px; } #channel-slot-2 { left: 630px; top: 0px; } #channel-slot-3 { left: 945px; top: 0px; }
#channel-slot-4 { left: 0px; top: 272px; } #channel-slot-5 { left: 315px; top: 272px; } #channel-slot-6 { left: 630px; top: 272px; } #channel-slot-7 { left: 945px; top: 272px; }
.channel-card.selected, .channel-card.focused { border: 2px #f3a447; background-color: #573047; }
.channel-card.focused { border-color: #fff2df; }
.channel-number { position: absolute; left: 16px; top: 10px; width: 70px; height: 24px; color: #f3a447; font-size: 14px; line-height: 22px; }
.channel-logo { position: absolute; left: 16px; top: 50px; width: 64px; height: 64px; background-color: #ad4c30; line-height: 64px; text-align: center; }
.channel-name { position: absolute; left: 94px; top: 48px; width: 188px; height: 32px; overflow: hidden; font-size: 20px; line-height: 30px; white-space: nowrap; text-overflow: ellipsis; }
.channel-meta { position: absolute; left: 94px; top: 84px; width: 188px; height: 54px; overflow: hidden; color: #c8afb6; font-size: 16px; line-height: 24px; text-overflow: ellipsis; }
.live-marker, .favorite-marker, .recent-marker { position: absolute; top: 158px; height: 22px; overflow: hidden; font-size: 12px; line-height: 20px; letter-spacing: 1px; }
.live-marker { left: 16px; width: 42px; color: #e8b968; }
.favorite-marker { left: 68px; width: 76px; color: #f1a24c; display: none; }
.recent-marker { left: 154px; width: 62px; color: #c8afb6; display: none; }
.favorite-marker.active, .recent-marker.active { display: block; }
.playback-marker { position: absolute; left: 16px; top: 188px; width: 100px; height: 22px; display: none; overflow: hidden; font-size: 12px; line-height: 20px; letter-spacing: 1px; }
.playback-marker.active { display: block; }
.playback-marker.playable { color: #64e6a6; }
.playback-marker.failed { color: #f16f72; }
.channel-tech { position: absolute; left: 16px; top: 220px; width: 267px; height: 22px; overflow: hidden; color: #e8b968; font-size: 14px; line-height: 20px; letter-spacing: 1px; white-space: nowrap; text-overflow: ellipsis; }
.empty-state { position: absolute; left: 0px; top: 220px; width: 1246px; color: #c8afb6; text-align: center; }

#channel-detail-region { position: absolute; left: 1262px; top: 216px; width: 530px; height: 528px; background-color: #31263b; }
#selected-channel-number { position: absolute; left: 24px; top: 56px; width: 70px; height: 50px; color: #f3a447; font-size: 32px; line-height: 46px; }
#selected-channel-name { position: absolute; left: 102px; top: 58px; width: 400px; height: 44px; overflow: hidden; font-size: 28px; line-height: 40px; white-space: nowrap; text-overflow: ellipsis; }
#selected-channel-meta { position: absolute; left: 24px; top: 116px; width: 482px; height: 58px; overflow: hidden; color: #c8afb6; font-size: 18px; line-height: 26px; }
#selected-channel-tech { position: absolute; left: 24px; top: 188px; width: 482px; height: 24px; overflow: hidden; color: #e8b968; font-size: 16px; line-height: 22px; letter-spacing: 1px; white-space: nowrap; text-overflow: ellipsis; }
#selected-channel-markers { position: absolute; left: 24px; top: 222px; width: 482px; height: 24px; }
#selected-channel-markers .favorite-marker, #selected-channel-markers .recent-marker { top: 0px; }
#selected-channel-markers .favorite-marker { left: 0px; } #selected-channel-markers .recent-marker { left: 90px; }
#selected-channel-markers .playback-marker { left: 180px; top: 0px; }
.primary-action { border: 1px #f3a447; background-color: #f3a447; color: #171321; text-align: center; }
.primary-action span { position: absolute; left: 0px; top: 14px; width: 100%; height: 34px; font-size: 20px; line-height: 32px; text-align: center; }
.primary-action img { position: absolute; left: 146px; top: 19px; }
.primary-action img + span { padding-left: 32px; }
#channel-play-button { position: absolute; left: 24px; top: 266px; width: 482px; height: 62px; }
#preview-status-region { position: absolute; left: 24px; top: 354px; width: 482px; height: 140px; border-top: 1px #6f4a61; }
#preview-status-dot { position: absolute; left: 0px; top: 22px; }
#preview-status-title { position: absolute; left: 22px; top: 13px; width: 450px; height: 32px; overflow: hidden; color: #e8b968; font-size: 18px; line-height: 28px; white-space: nowrap; text-overflow: ellipsis; }
#preview-status-message { position: absolute; left: 0px; top: 55px; width: 482px; height: 68px; overflow: hidden; color: #c8afb6; font-size: 16px; line-height: 24px; }

#screen-live-tv.favorites-view #source-region,
#screen-live-tv.favorites-view #group-region,
#screen-live-tv.favorites-view #search-region { display: none; }
#screen-live-tv.favorites-view #channel-region,
#screen-live-tv.favorites-view #channel-detail-region { top: 98px; }
#screen-live-tv.favorites-view #live-status-region,
#screen-live-tv.favorites-view #error-region { top: 642px; }

#live-status-region, #error-region { position: absolute; left: 0px; top: 760px; width: 1792px; height: 56px; border: 1px #6f4a61; background-color: #2a2134; }
#live-status-dot { position: absolute; left: 18px; top: 22px; }
#live-status-label { position: absolute; left: 42px; top: 12px; width: 280px; color: #e8b968; }
#live-status-detail { position: absolute; right: 18px; top: 12px; width: 900px; overflow: hidden; color: #c8afb6; text-align: right; white-space: nowrap; text-overflow: ellipsis; }
#error-region { border: 2px #e06a5f; background-color: #3a1f2c; }
#error-title { position: absolute; left: 18px; top: 12px; width: 300px; color: #e06a5f; }
#error-message { position: absolute; left: 330px; top: 12px; width: 1110px; overflow: hidden; color: #c8afb6; white-space: nowrap; text-overflow: ellipsis; }
#error-action { position: absolute; right: 12px; top: 7px; width: 310px; height: 40px; text-align: center; }
#error-action span { text-align: center; }

#source-management-region { position: absolute; left: 0px; top: 98px; width: 1060px; height: 640px; }
.source-management-card { position: absolute; left: 24px; width: 1012px; height: 164px; background-color: #191522; }
#source-management-slot-0 { top: 58px; } #source-management-slot-1 { top: 240px; }
.source-management-card span:first-child { position: absolute; left: 24px; top: 26px; width: 780px; height: 38px; font-size: 24px; line-height: 34px; }
.source-management-card span:nth-child(2) { position: absolute; left: 24px; top: 78px; width: 920px; height: 32px; overflow: hidden; color: #c8afb6; font-size: 16px; white-space: nowrap; text-overflow: ellipsis; }
.source-management-card .item-status { position: absolute; right: 24px; top: 28px; width: 180px; color: #e8b968; text-align: right; }
.source-management-card.selected, .source-management-card.focused { border: 2px #f3a447; background-color: #573047; }
.source-management-card.focused { border-color: #fff2df; }
#source-status-region { position: absolute; left: 1078px; top: 98px; width: 714px; height: 640px; background-color: #31263b; }
#source-status-label { position: absolute; left: 24px; top: 70px; width: 666px; height: 52px; overflow: hidden; font-size: 28px; line-height: 44px; }
#source-status-detail { position: absolute; left: 24px; top: 140px; width: 666px; height: 220px; overflow: hidden; color: #c8afb6; font-size: 18px; line-height: 28px; }
#source-refresh-button { position: absolute; left: 24px; top: 520px; width: 666px; height: 64px; }
.focused, button:focus { border: 3px #fff2df; }

#search-overlay { position: absolute; left: 0px; top: 96px; width: 1920px; height: 894px; background-color: #100d18; }
#search-panel { position: absolute; left: 160px; top: 48px; width: 1600px; height: 750px; border: 2px #6f4a61; background-color: #241c2e; }
.overlay-kicker { position: absolute; left: 48px; top: 34px; color: #f3a447; font-size: 16px; letter-spacing: 2px; }
.overlay-title { position: absolute; left: 48px; top: 68px; font-size: 36px; line-height: 48px; }
#search-help { position: absolute; left: 48px; top: 120px; width: 1200px; color: #c8afb6; font-size: 16px; }
#search-query-button { position: absolute; left: 48px; top: 172px; width: 1504px; height: 86px; background-color: #191522; }
.filter-label { position: absolute; left: 18px; top: 10px; color: #f3a447; font-size: 14px; line-height: 20px; letter-spacing: 1px; }
#search-query-value { position: absolute; left: 18px; top: 40px; width: 1468px; height: 32px; overflow: hidden; font-size: 20px; white-space: nowrap; text-overflow: ellipsis; }
#filter-row { position: absolute; left: 48px; top: 286px; width: 1504px; height: 142px; }
.filter-button { position: absolute; top: 0px; width: 364px; height: 142px; background-color: #191522; }
#filter-country { left: 0px; } #filter-category { left: 380px; } #filter-language { left: 760px; } #filter-quality { left: 1140px; }
.filter-button span:last-child { position: absolute; left: 18px; top: 54px; width: 328px; height: 54px; overflow: hidden; font-size: 20px; line-height: 30px; text-overflow: ellipsis; }
#search-result-count { position: absolute; left: 48px; top: 462px; width: 900px; color: #e8b968; font-size: 18px; }
#search-reset { position: absolute; left: 48px; top: 540px; width: 500px; height: 68px; text-align: center; }
#search-reset span { position: absolute; left: 0px; top: 17px; width: 500px; text-align: center; }
#search-apply { position: absolute; right: 48px; top: 540px; width: 680px; height: 68px; }
#search-apply span { top: 17px; }
#search-query-button.focused, .filter-button.focused, #search-reset.focused { border: 3px #fff2df; background-color: #573047; }
#search-apply.focused, #channel-play-button.focused, #source-refresh-button.focused { border: 4px #fff2df; }

#controller-footer { position: absolute; left: 0px; top: 990px; width: 1920px; height: 90px; border-top: 2px #6f4a61; background-color: #171321; }
.controller-hint { position: absolute; top: 24px; height: 42px; color: #c8afb6; font-size: 14px; line-height: 34px; }
.controller-hint img { position: absolute; left: 0px; top: 0px; width: 34px; height: 34px; }
.controller-hint img + span { position: absolute; left: 44px; top: 0px; white-space: nowrap; }
.hint-0 { left: 64px; width: 150px; } .hint-1 { left: 230px; width: 190px; } .hint-2 { left: 438px; width: 150px; } .hint-3 { left: 608px; width: 150px; } .hint-4 { left: 778px; width: 190px; } .hint-5 { left: 990px; width: 160px; }
.control-glyph { position: absolute; left: 0px; top: 2px; width: 82px; height: 30px; border: 1px #6f4a61; background-color: #2a2134; color: #fff2df; font-size: 12px; line-height: 28px; text-align: center; }
.control-glyph + span { position: absolute; left: 94px; top: 0px; white-space: nowrap; }
#footer-status { position: absolute; right: 64px; top: 26px; width: 320px; height: 38px; color: #e8b968; text-align: right; }
#footer-status-dot { position: absolute; right: 286px; top: 10px; }
#footer-status-label { position: absolute; right: 0px; top: 0px; width: 268px; overflow: hidden; white-space: nowrap; text-align: right; }
.warning { color: #f1a24c; } .error { color: #e06a5f; } .hidden { display: none; }
